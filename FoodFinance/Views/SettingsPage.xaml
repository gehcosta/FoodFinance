<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:viewmodel="clr-namespace:FoodFinance.ViewModels"
  x:Class="FoodFinance.Views.SettingsPage"
  Title="Configurações"
  BackgroundColor="{DynamicResource PageBackgroundColor}">

  <ContentPage.BindingContext>
      <viewmodel:SettingsViewModel />
  </ContentPage.BindingContext>

  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="20">

<Label Text="Configurações"
        FontSize="32"
     FontAttributes="Bold"
   HorizontalOptions="Center"
        TextColor="{DynamicResource Primary}"
  Margin="0,0,0,20" />

 <Frame Padding="15" 
        CornerRadius="10" 
        HasShadow="True"
 BackgroundColor="{DynamicResource CardBackgroundColor}">
  <VerticalStackLayout Spacing="15">

          <Label Text="Tema do Aplicativo" 
  FontSize="16" 
            FontAttributes="Bold"
      TextColor="{DynamicResource Gray900}" />
    <Picker ItemsSource="{Binding Themes}"
      SelectedItem="{Binding SelectedTheme}"
            FontSize="16"
            HorizontalOptions="Fill" />

          <BoxView HeightRequest="1" 
        Color="{DynamicResource Gray200}"
     Margin="0,10" />

     <Label Text="Preço do litro da gasolina" 
       FontSize="16" 
    FontAttributes="Bold"
            TextColor="{DynamicResource Gray900}" />
          <Entry Text="{Binding GasPrice}"
       Keyboard="Numeric"
            FontSize="16"
        Placeholder="Ex: 6.50"
  PlaceholderColor="{DynamicResource Gray400}" />

    <BoxView HeightRequest="1" 
     Color="{DynamicResource Gray200}"
      Margin="0,10" />

          <Label Text="Km por Litro" 
   FontSize="16" 
    FontAttributes="Bold"
  TextColor="{DynamicResource Gray900}" />
       <Entry Text="{Binding KmPerLiter}"
       Keyboard="Numeric"
    FontSize="16"
         Placeholder="Ex: 30"
  PlaceholderColor="{DynamicResource Gray400}" />

     <BoxView HeightRequest="1" 
            Color="{DynamicResource Gray200}"
 Margin="0,10" />

          <Label Text="Manutenção por Km (R$)" 
            FontSize="16" 
   FontAttributes="Bold"
            TextColor="{DynamicResource Gray900}" />
          <Entry Text="{Binding MaintenancePerKm}"
     Keyboard="Numeric"
            FontSize="16"
          Placeholder="Ex: 0.20"
   PlaceholderColor="{DynamicResource Gray400}" />

        </VerticalStackLayout>
      </Frame>

    <Button Text="Salvar Configurações"
Command="{Binding SaveSettingsCommand}"
        BackgroundColor="{DynamicResource Primary}"
 TextColor="White"
        FontSize="18"
        FontAttributes="Bold"
        CornerRadius="8"
        HeightRequest="55"
        Margin="0,10,0,0" />

    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
