<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:FoodFinance.ViewModels"
    xmlns:converters="clr-namespace:FoodFinance.Converters"
    x:Class="FoodFinance.Views.DayEntryPage"
    Title="Registro Diário">

    <ContentPage.Resources>
      <converters:TimerTextConverter x:Key="TimerTextConverter" />
    </ContentPage.Resources>

    <ContentPage.BindingContext>
     <viewmodel:DayEntryViewModel />
 </ContentPage.BindingContext>

  <ScrollView>
 <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">

    <Label Text="FoodFinance"
          FontSize="32"
    FontAttributes="Bold"
    HorizontalOptions="Center"
   TextColor="{DynamicResource Primary}" />

     <Label Text="Registre seu dia de trabalho"
    FontSize="16"
  HorizontalOptions="Center"
   TextColor="{DynamicResource Gray600}"
         Margin="0,0,0,20" />

          <Frame Padding="15" Style="{StaticResource CardFrame}">
          <VerticalStackLayout Spacing="15">

<Label Text="Data" 
    FontSize="14"/>
        <DatePicker Date="{Binding Date}"
   FontSize="16"
HorizontalOptions="Fill" />

         <Label Text="Km percorridos" 
      FontSize="14" 
    Margin="0,10,0,0" />
      <Entry Placeholder="Ex: 27.5"
         Keyboard="Numeric"
     Text="{Binding Km}"
   FontSize="16"/>

          <Label Text="Ganho do dia (R$)" 
 FontSize="14" 
         Margin="0,10,0,0" />
    <Entry Placeholder="Ex: 51.42"
     Keyboard="Numeric"
   Text="{Binding Earned}"
  FontSize="16"/>

  <Label Text="Tempo trabalhado" 
       FontSize="14" 
 Margin="0,10,0,0" />
   <Label Text="{Binding ElapsedTimeText}"
       FontSize="32"
     FontAttributes="Bold"
            HorizontalOptions="Center"
       TextColor="{DynamicResource Primary}" />

 <Button Text="{Binding TimerRunning, Converter={StaticResource TimerTextConverter}}"
        Command="{Binding ToggleTimerCommand}"
    BackgroundColor="{DynamicResource Secondary}"
  TextColor="White"
         FontSize="16"
  CornerRadius="8"
   HeightRequest="50"
         Margin="0,10,0,0" />

 </VerticalStackLayout>
  </Frame>

  <Button Text="Finalizar meu dia"
Command="{Binding FinalizeDayCommand}"
  BackgroundColor="{DynamicResource Primary}"
  TextColor="White"
    FontSize="18"
      FontAttributes="Bold"
      CornerRadius="8"
         HeightRequest="55"
     Margin="0,10,0,0" />

  </VerticalStackLayout>
    </ScrollView>

</ContentPage>
